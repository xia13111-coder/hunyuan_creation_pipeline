# Standalone web applications keep source but not dependency/build trees.
/apps/**/node_modules/
/apps/**/.next/
/apps/**/dist/

# The local material-audit site is a separate nested repository containing
# workpiece photographs and generated audit data. It is not part of the public
# root source release; publish a separately sanitized app repository instead.
/apps/material_audit_web/

# Example photographs and annotations are local inputs, not source code.
/examples/*/references/*
/examples/dtn100/
/annotations/

# Material-pipeline local runtimes, model weights, caches and results.
/tools/qwen_material_pipeline/.venv/
/tools/qwen_material_pipeline/runtime/*
!/tools/qwen_material_pipeline/runtime/README.md

# Local third-party SAM3D checkouts and model weights.
/tools/sam3d/third_party/

data/*
!data/.gitkeep

.DS_Store

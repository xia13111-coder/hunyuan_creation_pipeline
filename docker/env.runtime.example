# Copy to docker/.env.runtime and replace every /absolute/path value.
# Paths are host paths. The Compose stack mounts model runtimes at the same
# absolute paths so external Python environments keep their original prefix.
# Keep this file mode 0600 and never commit real credentials.

PIPELINE_IMAGE=hunyuan-allinone:isaac-6.0.1-materials
PIPELINE_ENV_IMAGE=hunyuan-allinone:isaac-6.0.1
ISAACSIM_BASE_IMAGE=isaacsim_sim:latest
PIPELINE_CONTAINER_NAME=hunyuan-pipeline-601
HUB_CONTAINER_NAME=isaac-hub-cache
HUB_IMAGE=nvcr.io/nvidia/omniverse/hub_workstation_cache:2.0.0
PIPELINE_UID=1234
PIPELINE_GID=1234
PIPELINE_MIN_FREE_GB=50
# Candidate builds temporarily coexist with the current image under DockerRootDir.
PIPELINE_DOCKER_MIN_BUILD_FREE_GB=15
PIPELINE_START_TIMEOUT_SECONDS=300
PIPELINE_MIN_NOFILE=65536

# REQUIRED: checkout, writable outputs, caches and Isaac state.
PROJECT_ROOT=/absolute/path/hunyuan3.0_assets_creation
ASSET_ROOT=/absolute/path/pipeline-assets
MODEL_CACHE_ROOT=/absolute/path/model-cache
ISAAC_CACHE_ROOT=/absolute/path/isaac-sim-6.0.1

# REQUIRED: Qwen3.5 runtime and model.
QWEN35_RUNTIME_DIR=/absolute/path/qwen35_4b_runtime
QWEN35_PYTHON=/absolute/path/qwen35_4b_runtime/env/bin/python
QWEN35_MODEL_PATH=/absolute/path/qwen35_4b_runtime/model

# REQUIRED: MVInverse source and checkpoint directory.
MVINVERSE_REPOSITORY=/absolute/path/mvinverse
MVINVERSE_CHECKPOINT=/absolute/path/mvinverse/model

# REQUIRED: SAM3 source and checkpoint.
SAM3_REPOSITORY=/absolute/path/sam3
SAM3_CHECKPOINT=/absolute/path/sam3.pt

# REQUIRED: SAM3D single/multi-view source and local depth/feature weights.
SAM3D_SINGLE_VIEW_ROOT=/absolute/path/sam-3d-objects
SAM3D_MULTI_VIEW_ROOT=/absolute/path/sam-3d-objects-multiview
SAM3D_PIPELINE_CONFIG=/absolute/path/sam-3d-objects/checkpoints/pipeline.yaml
SAM3D_MOGE_CHECKPOINT=/absolute/path/moge/model.pt
SAM3D_DINOV2_REPOSITORY=/absolute/path/facebookresearch_dinov2_main
SAM3D_DINOV2_CHECKPOINT=/absolute/path/dinov2_vitl14_reg4_pretrain.pth

# REQUIRED: EntitySeg virtual environment, CropFormer source/config and weight.
ENTITYSEG_RUNTIME_DIR=/absolute/path/entityseg_venv
# Base Python prefix targeted by entityseg_venv/bin/python when it is a symlink.
ENTITYSEG_BASE_RUNTIME_DIR=/absolute/path/base-python-environment
ENTITYSEG_DETECTRON2_ROOT=/absolute/path/detectron2_cropformer
ENTITYSEG_PYTHON=/absolute/path/entityseg_venv/bin/python
ENTITYSEG_CROPFORMER_ROOT=/absolute/path/CropFormer
ENTITYSEG_CONFIG=/absolute/path/CropFormer/configs/entityv2/entity_segmentation/cropformer_swin_tiny_3x.yaml
ENTITYSEG_CHECKPOINT=/absolute/path/CropFormer_swin_tiny_3x_5cea5e.pth

# REQUIRED: retrieval models, NVIDIA Base materials and observation bank.
SIGLIP2_MODEL_PATH=/absolute/path/siglip2-base-patch16-224
DINOV2_MODEL_PATH=/absolute/path/dinov2-with-registers-large
VISUAL_MATERIAL_ROOT=/absolute/path/nvidia-materials
NVIDIA_BASE_OBSERVATION_BANK=/absolute/path/nvidia_base_observation_bank_v1
VISUAL_RETRIEVAL_CACHE=/absolute/path/visual-retrieval-cache

# Runtime policy. Local inference never downloads missing model weights.
PIPELINE_LOCAL_MODELS_ONLY=1
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
PIPELINE_MAX_WORKERS=1
PIPELINE_MAX_LOG_LINES=2000
REFINE_MESH_TEMP_UPLOAD=uguu

# Optional: only Hunyuan generation/refinement needs Tencent credentials.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

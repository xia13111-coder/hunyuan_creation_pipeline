# Rebuildable runtime state and machine-local dependencies.
/runtime/*
!/runtime/README.md
/.env
/.venv/

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Coverage and packaging outputs.
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

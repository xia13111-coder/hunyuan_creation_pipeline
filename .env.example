# Copy this file to .env. The program loads it automatically; do not `source` it.
# Never commit .env or secrets.

# Keep local inference offline. Download models only with `qwen-material setup-models`.
PIPELINE_LOCAL_MODELS_ONLY=1

# Optional cache locations. Blank values use the standard user cache.
HF_HOME=
TORCH_HOME=

# Only for Tencent Hunyuan generation or refinement.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

# Required for local STEP/STP conversion and automatic material assignment.
# ISAAC_PYTHON must point to Isaac Sim's python.sh.
# VISUAL_MATERIAL_ROOT must be the Materials directory containing Base/.
ISAAC_PYTHON=
VISUAL_MATERIAL_ROOT=

# Optional overrides. Normally leave blank; the project discovers these paths.
ISAACSIM_ROOT=
QWEN_MATERIAL_RUNTIME_ROOT=
MATERIAL_PROJECTS_ROOT=

# Only for SAM3D image reconstruction. Leave blank for STEP/STP materials.
SAM3D_SINGLE_VIEW_ROOT=
SAM3D_MULTI_VIEW_ROOT=
SAM3D_PIPELINE_CONFIG=
SAM3D_MOGE_CHECKPOINT=
SAM3D_DINOV2_REPOSITORY=
SAM3D_DINOV2_CHECKPOINT=

# Optional runtime tuning.
REFINE_MESH_TEMP_UPLOAD=
PIPELINE_MAX_WORKERS=
PIPELINE_MAX_LOG_LINES=

# `qwen-material setup-models --model-root <directory>` appends all automatic
# Blender, model, source, EntitySeg runtime, observation-bank, and cache paths below.

# Copy to .env for local use. The main CLIs load it automatically.
# Existing shell variables take precedence; blank values use automatic discovery.
# Do not commit .env or real credentials.

# Normal inference is local-only. Missing weights fail before inference instead
# of being downloaded implicitly from Hugging Face or Torch Hub.
PIPELINE_LOCAL_MODELS_ONLY=1
HF_HOME=
TORCH_HOME=

# Tencent Hunyuan / ReduceFace. Leave blank when those stages are unused.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

# External executables. ISAAC_PYTHON is preferred when it is known.
BLENDER_BIN=
ISAACSIM_ROOT=
ISAAC_PYTHON=

# Local visual-model runtimes and checkpoints.
QWEN35_PYTHON=
QWEN35_MODEL_PATH=
QWEN_PYTHON=
QWEN_MODEL_PATH=
MVINVERSE_PYTHON=
MVINVERSE_REPOSITORY=
MVINVERSE_CHECKPOINT=
SIGLIP2_MODEL_PATH=
DINOV2_MODEL_PATH=
MODEL_CACHE_ROOT=
VISUAL_RETRIEVAL_CACHE=
NVIDIA_BASE_OBSERVATION_BANK=

# NVIDIA material library. The current pipeline reads VISUAL_MATERIAL_ROOT.
# Point it to NVIDIA/Materials; selection remains restricted to its Base subtree.
VISUAL_MATERIAL_ROOT=

# Backward-compatible aliases. Prefer VISUAL_MATERIAL_ROOT for new setups.
NVIDIA_MDL_MATERIALS_ROOT=
NVIDIA_MDL_BASE_ROOT=

# SAM3/SAM3D local repositories, configs, and weights.
# Project-local defaults are discovered when these values are blank.
SAM3_REPOSITORY=
SAM3_CHECKPOINT=
SAM3D_SINGLE_VIEW_ROOT=
SAM3D_MULTI_VIEW_ROOT=
SAM3D_PIPELINE_CONFIG=
SAM3D_MOGE_CHECKPOINT=
SAM3D_DINOV2_REPOSITORY=
SAM3D_DINOV2_CHECKPOINT=

# Optional runtime controls.
REFINE_MESH_TEMP_UPLOAD=
PIPELINE_MAX_WORKERS=
PIPELINE_MAX_LOG_LINES=

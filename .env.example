# Copy to .env. `qwen-material setup-models` appends runtime/model/source paths.
# Blank values use automatic discovery. Do not commit .env or secrets.

# Local inference never downloads weights.
PIPELINE_LOCAL_MODELS_ONLY=1
HF_HOME=
TORCH_HOME=

# Cloud generation only.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

# Local tools.
ISAACSIM_ROOT=
ISAAC_PYTHON=

# Optional material runtime paths.
QWEN_MATERIAL_RUNTIME_ROOT=
MATERIAL_PROJECTS_ROOT=

# NVIDIA Materials directory containing Base/.
VISUAL_MATERIAL_ROOT=

# SAM3D image reconstruction (not STEP/STP material assignment).
SAM3D_SINGLE_VIEW_ROOT=
SAM3D_MULTI_VIEW_ROOT=
SAM3D_PIPELINE_CONFIG=
SAM3D_MOGE_CHECKPOINT=
SAM3D_DINOV2_REPOSITORY=
SAM3D_DINOV2_CHECKPOINT=

# Runtime controls.
REFINE_MESH_TEMP_UPLOAD=
PIPELINE_MAX_WORKERS=
PIPELINE_MAX_LOG_LINES=
